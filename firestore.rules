rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /personal_expenses/{expenseId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /orders/{orderId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.clientId;
      allow read, update: if request.auth != null;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    match /notifications/{notifId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.recipientId;
      allow create: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if true; // Solo para desarrollo inicial, luego restringiremos
    }
  }
}
