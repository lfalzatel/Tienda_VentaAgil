[
  {
    "origin": ["*"],
    "method": ["GET", "PUT", "POST", "DELETE", "OPTIONS", "HEAD"],
    "maxAgeSeconds": 3600,
    "responseHeader": [
      "Authorization",
      "Content-Type",
      "Content-Length",
      "User-Agent",
      "x-goog-resumable",
      "X-Firebase-Storage-Version",
      "X-Goog-Upload-Command",
      "X-Goog-Upload-Content-Type",
      "X-Goog-Upload-Header-Content-Length",
      "X-Goog-Upload-Offset",
      "X-Goog-Upload-Protocol"
    ]
  }
]
